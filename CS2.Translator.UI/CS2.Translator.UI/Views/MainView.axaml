<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CS2.Translator.UI.ViewModels"
    x:Class="CS2.Translator.UI.Views.MainView"
    x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*"
          Background="#0E0E12">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#14141A"
                Padding="12"
                BorderBrush="#2E2E40"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock
                    Text="CS2 Translator"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <Button
                    Grid.Column="1"
                    Content="Clear Chat"
                    Command="{Binding ClearChatsCommand}"
                    Padding="10,4"
                    Background="#3A3AF5"
                    Foreground="White"
                    CornerRadius="6"/>
                <Button
                    Grid.Column="2"
                    Content="Settings"
                    Command="{Binding OpenSettingsCommand}"
                    Padding="10,4"
                    Background="#3A3AF5"
                    Foreground="White"
                    CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- CHAT -->
        <ScrollViewer Grid.Row="1"
                      Padding="12"
                      x:Name="ChatScrollViewer">

            <ItemsControl ItemsSource="{Binding Chats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">

                        <Grid Margin="0,0,0,10">
                            
                            <Border
                                Background="#1E1E26"
                                CornerRadius="10"
                                Padding="10"
                                MaxWidth="380"
                                HorizontalAlignment="Left">

                                <StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="4">
									    <TextBlock
                                            Text="{Binding ChatType, StringFormat='[{0}]'}"
                                            FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Foreground="#AAAAAA"/>
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            FontFamily="'Noto Sans'"
                                            Foreground="#AAAAAA"/>
									    <TextBlock
                                            Text="{Binding Location, StringFormat='@ {0}'}"
                                            FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Foreground="#00FF00"
											IsVisible="{Binding HasLocation}"/>
									</StackPanel>

									<SelectableTextBlock
                                        Text="{Binding TranslationText}"
                                        FontSize="{Binding DataContext.TranslationFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        FontFamily="'Cambria Math', 'Segoe UI Symbol', 'Segoe UI Emoji', 'Segoe UI', 'Arial Unicode MS'"
                                        TextWrapping="Wrap"
                                        Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Grid>
</UserControl>
